# ==============================================================================
# FaceTube - Uploads & Media Storage Apache Configuration
# Configures CORS, HTTP Range streaming, media MIME types, and uploads security
# ==============================================================================

# 1. Enable Cross-Origin Resource Sharing (CORS) for media streaming
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Content-Type, Accept, Origin"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
    Header set Cache-Control "public, max-age=86400"
</IfModule>

# 2. Support proper media MIME types and streaming
<IfModule mod_mime.c>
    AddType video/mp4 .mp4 .m4v
    AddType video/webm .webm
    AddType video/ogg .ogv .ogg
    AddType video/quicktime .mov
    AddType video/x-matroska .mkv
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/webp .webp
    AddType image/gif .gif
</IfModule>

# 3. Security hardening: Block PHP script execution inside media storage subfolders
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Allow video and image files
<FilesMatch "\.(mp4|webm|ogg|mov|m4v|mkv|jpg|jpeg|png|webp|gif)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

# 5. Disable directory browsing for security
Options -Indexes
