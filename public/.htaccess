# ==============================================================================
# FaceTube - Apache 2.4 Web Server Configuration (Hostinger / cPanel)
# ==============================================================================

# 1. Block direct browser access to sensitive configuration files & database dumps
<FilesMatch "^\.env|.*\.sql$|composer\.(json|lock)$|\.git.*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Options
Options -Indexes

# 3. Charset
AddDefaultCharset UTF-8

# 4. Redirect direct /uploads/ media requests on facetube.online to the API media host
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/uploads/(.*)$ [NC]
    RewriteRule ^uploads/(.*)$ https://api.facetube.online/uploads/$1 [R=302,L]
</IfModule>
